[sub_resource type="GDScript" id=4]
script/source = "extends Label

var player_turn_copy = gl.player_turn

func _ready():
	$\".\".text = \"Сейчас ходит: Игрок\"

func _process(delta):
	if player_turn_copy != gl.player_turn and not gl.fl_game_end:
		if gl.player_turn:
			$\".\".text = \"Сейчас ходит: Игрок\"
		else:
			$\".\".text = \"Сейчас ходит: Компьютер\"
		player_turn_copy = gl.player_turn
	if gl.fl_game_end:
		$\".\".text = \"%s выйграл!\" % gl.winner 
"

